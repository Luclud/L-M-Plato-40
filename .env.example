# Optional: LLM wording for guest messages (plato40/llm.py).
# The pipeline runs fully without these (deterministic templates). Copy to .env (git-ignored).
# Used only to rephrase template text; output is rejected (template kept) if any digit
# (time, room id) changes. Also used (viewer only, never by run.py) by scripts/summarise_incidents.py
# for AI incident summaries; guarded the same way, template summaries without a key.
# The viewer's "Ask the building" page (viewer/copilot.py) uses it read-only with tool use (anthropic only);
# without a key it shows cached examples (viewer/copilot_cache.json) and offline look-ups.
# Temperature 0, cached in .llm_cache/. `run.py --no-llm` forces templates.
LLM_PROVIDER=          # anthropic | openai
LLM_API_KEY=
LLM_MODEL=             # e.g. the provider's model id
LLM_BASE_URL=          # optional: OpenAI-compatible endpoint
